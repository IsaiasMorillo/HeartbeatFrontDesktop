<Window x:Class="Heartbeat.Desktop.Assistant.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:Heartbeat.Desktop.Localization"
        Title="{loc:Loc assistant.title}"
        Width="620" Height="720" MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBodyBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="{loc:Loc assistant.title}" Style="{StaticResource TitleTextStyle}" />
            <TextBlock Text="{loc:Loc assistant.subtitle}" Style="{StaticResource CaptionTextStyle}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="14" Padding="14">
            <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Bubble" Background="{DynamicResource BrandBlueSoftBrush}" CornerRadius="12"
                                    Padding="12,9" Margin="0,0,48,10" HorizontalAlignment="Left" MaxWidth="480">
                                <StackPanel>
                                    <TextBlock Text="{Binding Author}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrandBlueBrush}" />
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="Bubble" Property="Margin" Value="48,0,0,10" />
                                    <Setter TargetName="Bubble" Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <ItemsControl Grid.Row="2" ItemsSource="{Binding SuggestedQuestions}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,5" Margin="0,0,8,8"
                            Command="{Binding DataContext.UseSuggestionCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource BrandRedBrush}" FontWeight="SemiBold"
                       TextWrapping="Wrap" Visibility="{Binding ErrorText, Converter={StaticResource NonEmptyToVisibility}}" Margin="0,0,0,8" />
            <TextBlock Text="{loc:Loc assistant.thinking}" Style="{StaticResource CaptionTextStyle}"
                       Visibility="{Binding IsSending, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,6" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{loc:Loc assistant.send}" Command="{Binding SendCommand}"
                        Margin="10,0,0,0" VerticalAlignment="Bottom" />
                <TextBox Text="{Binding Question, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="58" MaxHeight="120"
                         VerticalScrollBarVisibility="Auto" Padding="10" />
            </DockPanel>
        </StackPanel>

        <TextBlock Grid.Row="4" Text="{loc:Loc assistant.disclaimer}" Style="{StaticResource CaptionTextStyle}"
                   FontWeight="SemiBold" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
